# Copy to .env and fill in. No site-specific values are baked into the image.

# The tester device on your 44net segment
DEVICE=44.xx.yy.66

# An address in your allocation with nothing on it (test 5)
UNUSED=44.xx.yy.77

# Ports: the UDP port the device listens on, a port your firewall permits
# inbound, and one it must block.
UDP_PORT=5000
ALLOWED_PORT=80
BLOCKED_PORT=22

# OTA push (ota-push.sh only)
GITHUB_REPO=swissdigitalnet/44-net
OTA_TOKEN=change-me
