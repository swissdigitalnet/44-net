# Copy to .env and fill in. No site-specific values are baked into the image.

# Your allocation. The runner sweeps it, recognises the tester by the id it
# reports, and picks a quiet address for the empty-address test. An allocation
# is small enough that nobody should have to look up where the device landed.
NETWORK=44.xx.yy.64/28

# Optional overrides. Leave unset to let discovery do it.
#DEVICE=44.xx.yy.66
#UNUSED=44.xx.yy.77

# Optional: a host you have deliberately kept unreachable from 44net. Test 3b
# checks it stays that way. Leave unset to skip.
#EXCLUDED=44.xx.yy.78

# Ports: the UDP port the device listens on, a port your firewall permits
# inbound, and one it must block.
UDP_PORT=5000
# The tester does not listen on 80 - port 80 is the most scanned port there is
ALLOWED_PORT=8044
BLOCKED_PORT=80

# OTA push (ota-push.sh only)
GITHUB_REPO=swissdigitalnet/44-net
OTA_TOKEN=change-me
